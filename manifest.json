{
  "manifest_version": 3,
  "name": "ProfitMR",
  "description": "Calculadora de cartões e pontos para comparar custos e estimar resgates no Microsoft Rewards.",
  "version": "1.1.0",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://rewards.bing.com/redeem/sku/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rewards.bing.com/redeem/sku/*"],
      "js": ["regions.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_title": "ProfitMR",
    "default_popup": "popup.html"
  }
}
